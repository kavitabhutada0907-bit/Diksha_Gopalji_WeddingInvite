      margin: 0 auto;
    }

    .schedule-heading {
      font-family: var(--font-script);
      font-weight: 400;
      font-size: clamp(2.85rem, 6.5vw, 4.25rem);
      text-align: center;
      color: #ffffff;
      margin-bottom: 2.75rem;
    }

    .date-divider {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1.25rem;
      margin-bottom: 2.5rem;
    }

    .date-divider-line {
      height: 1px;
      flex: 1;
      max-width: 150px;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
    }

    .date-divider-text {
      font-family: var(--font-caps);
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: #ffffff;
    }

    .timeline-list {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
      padding: 0.5rem 0;
    }

    /* Center Vertical Line */
    .timeline-list::before {
      content: "";
      position: absolute;
      top: 0.9rem;
      bottom: 0.9rem;
      left: 50%;
      transform: translateX(-50%);
      width: 1px;
      background-color: rgba(255, 255, 255, 0.42);
    }

    .timeline-row {
      display: grid;
      grid-template-columns: 1fr 36px 1fr;
      align-items: center;
      gap: 0.75rem;
    }

    .timeline-time {
      text-align: right;
      font-family: var(--font-title);
      font-size: clamp(0.88rem, 2vw, 1.05rem);
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #ffffff;
      padding-right: 0.5rem;
    }

    .timeline-marker-wrap {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .timeline-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background-color: #ffffff;
      box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25), 0 0 10px rgba(255, 255, 255, 0.75);
    }

    .timeline-event {
      text-align: left;
      font-family: var(--font-script);
      font-size: clamp(1.9rem, 4.2vw, 2.45rem);
      line-height: 1.15;
      color: #ffffff;
      padding-left: 0.5rem;
    }

    /* =====================================================================
       6. SECTION 5: VENUE & TRAVEL (WARM CREAM)
       ===================================================================== */
    .venue-section {
      background-color: var(--cream-bg);
      color: var(--text-dark);
      padding: 6rem 1.5rem 7rem;
      display: flex;
      justify-content: center;
