    .countdown-inner {
      position: relative;
      z-index: 1;
      max-width: 720px;
      margin: 0 auto;
    }

    .countdown-heading {
      font-family: var(--font-script);
      font-weight: 400;
      font-size: clamp(2.85rem, 6.5vw, 4.25rem);
      line-height: 1.12;
      color: var(--burgundy-deep);
      margin-bottom: 3rem;
    }

    .countdown-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      max-width: 580px;
      margin: 0 auto;
    }

    .countdown-box {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .countdown-number {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: clamp(2.5rem, 6.5vw, 4.25rem);
      line-height: 1;
      color: var(--burgundy-deep);
    }

    .countdown-label {
