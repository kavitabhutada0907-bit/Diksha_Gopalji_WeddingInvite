    .hero-bg-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: 0;
    }

    /* Subtle Dark Gradient Overlay for Crisp Readability & Visible Crackers */
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(15, 22, 32, 0.42) 0%,
        rgba(20, 14, 12, 0.34) 45%,
        rgba(16, 10, 10, 0.72) 100%
      );
      z-index: 1;
    }

    /* Celebration Firecrackers Canvas */
    #fireworks-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 2;
    }

    /* Top Wedding Date Badge */
    .hero-date-badge {
      position: relative;
      z-index: 3;
      display: inline-block;
      padding: 0.55rem 1.75rem;
      border-top: 1px solid rgba(255, 255, 255, 0.72);
      border-bottom: 1px solid rgba(255, 255, 255, 0.72);
