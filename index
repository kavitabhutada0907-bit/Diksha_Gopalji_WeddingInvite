      z-index: 3;
      margin: auto 0;
      padding: 1.5rem 0;
    }

    .hero-names {
      font-family: var(--font-hero-display);
      font-weight: 700;
      color: #ffffff;
      line-height: 1.08;
      letter-spacing: 0.05em;
      text-shadow: 0 4px 24px rgba(0, 0, 0, 0.65), 0 2px 6px rgba(0, 0, 0, 0.55);
    }

    .hero-name-line {
      display: block;
      font-size: clamp(2.85rem, 7.5vw, 5.5rem);
    }

    .hero-ampersand {
      display: block;
      font-family: var(--font-script);
      font-weight: 400;
      font-size: clamp(2.5rem, 5.5vw, 4rem);
      color: var(--gold-accent);
