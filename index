        set("cfg-invite-body", WEDDING_CONFIG.invitationText);
        set("cfg-invite-signoff", WEDDING_CONFIG.invitationSignOff);
        set("cfg-schedule-date", WEDDING_CONFIG.scheduleDateHeading);
        set("cfg-footer-names", WEDDING_CONFIG.brideName + " & " + WEDDING_CONFIG.groomName);

        // Events
        const eventsList = document.getElementById("cfg-events-list");
        if (eventsList) {
          eventsList.innerHTML = WEDDING_CONFIG.events
            .map(
              (ev) => `
              <div class="timeline-row">
                <div class="timeline-time">${ev.time}</div>
                <div class="timeline-marker-wrap"><span class="timeline-dot"></span></div>
                <div class="timeline-event">${ev.name}</div>
              </div>
            `
            )
            .join("");
        }

        // Venue
        set("cfg-venue-name", WEDDING_CONFIG.venue.name);
        set("cfg-venue-street", WEDDING_CONFIG.venue.street);
        set("cfg-venue-city", WEDDING_CONFIG.venue.city);
        set("cfg-venue-state", WEDDING_CONFIG.venue.state);
        set("cfg-venue-pin", WEDDING_CONFIG.venue.pin);
        set("cfg-venue-country", WEDDING_CONFIG.venue.country);

        const mapsLink = document.getElementById("cfg-maps-link");
        if (mapsLink) mapsLink.href = WEDDING_CONFIG.venue.mapsUrl;

        // Transport modal list
        const transportList = document.getElementById("cfg-transport-list");
        if (transportList) {
          transportList.innerHTML = WEDDING_CONFIG.transport
            .map(
              (t) => `
              <div class="transport-item">
                <p class="transport-mode-tag">${t.icon} ${t.mode}</p>
                <h4>${t.title}</h4>
                <p>${t.details}</p>
              </div>
            `
            )
            .join("");
        }
      }

      // 2. Hero Celebration Firecrackers Canvas
      function initHeroFirecrackers() {
        const canvas = document.getElementById("fireworks-canvas");
        const hero = document.getElementById("top");
        if (!canvas || !hero) return;

        const ctx = canvas.getContext("2d");
        let w = (canvas.width = hero.offsetWidth);
        let h = (canvas.height = hero.offsetHeight);

        const colors = ["#FFD97D", "#F6B93B", "#FFF3CD", "#F8A5C2", "#FF9F43"];
        const rockets = [];
        const sparks = [];

        window.addEventListener("resize", () => {
          w = canvas.width = hero.offsetWidth;
          h = canvas.height = hero.offsetHeight;
        });

        function launch(xRatio) {
          const startX = typeof xRatio === "number" ? w * xRatio : w * (0.15 + Math.random() * 0.7);
          rockets.push({
            x: startX,
            y: h * 0.88,
            vx: (Math.random() - 0.5) * 1.2,
            vy: -(6 + Math.random() * 2.4),
            targetY: h * (0.14 + Math.random() * 0.3),
            color: colors[Math.floor(Math.random() * colors.length)],
            trail: []
          });
        }

        function burst(x, y, color) {
          const count = 44;
          for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.15;
            const speed = 1.4 + Math.random() * 3.4;
            sparks.push({
              x,
              y,
              vx: Math.cos(angle) * speed,
              vy: Math.sin(angle) * speed,
              alpha: 1,
              decay: 0.014 + Math.random() * 0.01,
              size: 1.5 + Math.random() * 1.6,
              color: Math.random() < 0.35 ? "#FFFDF5" : color
            });
          }
        }

        launch(0.24);
        setTimeout(() => launch(0.76), 550);

        let tick = 0;
        function loop() {
          ctx.clearRect(0, 0, w, h);
          tick++;

          if (tick % 95 === 0 && rockets.length < 3) {
            launch();
          }

          for (let i = rockets.length - 1; i >= 0; i--) {
            const r = rockets[i];
            r.trail.push({ x: r.x, y: r.y });
            if (r.trail.length > 7) r.trail.shift();

            r.x += r.vx;
            r.y += r.vy;
            r.vy += 0.045;

            r.trail.forEach((pt, idx) => {
              ctx.save();
              ctx.globalAlpha = (idx / r.trail.length) * 0.65;
              ctx.fillStyle = r.color;
              ctx.beginPath();
              ctx.arc(pt.x, pt.y, 1.6, 0, Math.PI * 2);
              ctx.fill();
              ctx.restore();
            });

            if (r.y <= r.targetY || r.vy >= -0.8) {
              burst(r.x, r.y, r.color);
              rockets.splice(i, 1);
            }
          }

          for (let i = sparks.length - 1; i >= 0; i--) {
            const s = sparks[i];
            s.vx *= 0.975;
            s.vy = s.vy * 0.975 + 0.04;
            s.x += s.vx;
            s.y += s.vy;
            s.alpha -= s.decay;

            if (s.alpha <= 0) {
              sparks.splice(i, 1);
              continue;
            }

            ctx.save();
            ctx.globalAlpha = s.alpha;
            ctx.fillStyle = s.color;
            ctx.shadowBlur = 8;
            ctx.shadowColor = s.color;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }

          requestAnimationFrame(loop);
        }

        loop();
      }

      // 3. Live Countdown Timer (Counts down to 04/12/2026 07:00 AM IST)
      function initCountdown() {
        const headingEl = document.getElementById("countdown-heading");
        const dEl = document.getElementById("cd-days");
        const hEl = document.getElementById("cd-hours");
        const mEl = document.getElementById("cd-minutes");
        const sEl = document.getElementById("cd-seconds");
        const target = new Date(WEDDING_CONFIG.countdownTargetISO).getTime();

        const pad = (n) => String(Math.max(0, n)).padStart(2, "0");

        function update() {
          if (isNaN(target)) {
            dEl.textContent = "00";
            hEl.textContent = "00";
            mEl.textContent = "00";
            sEl.textContent = "00";
            return;
          }

          const now = Date.now();
          const diff = target - now;

          if (diff <= 0) {
            if (headingEl) {
              headingEl.innerHTML = "The Celebration<br />Has Begun";
            }
            dEl.textContent = "00";
            hEl.textContent = "00";
            mEl.textContent = "00";
            sEl.textContent = "00";
            return;
          }

          if (headingEl) {
            headingEl.innerHTML = "The Celebration<br />Begins In";
          }

          dEl.textContent = pad(Math.floor(diff / 86400000));
          hEl.textContent = pad(Math.floor((diff / 3600000) % 24));
          mEl.textContent = pad(Math.floor((diff / 60000) % 60));
          sEl.textContent = pad(Math.floor((diff / 1000) % 60));
        }

        update();
        setInterval(update, 1000);
      }

      // 4. Countdown Section Confetti Petals Canvas
      function initCountdownConfetti() {
        const canvas = document.getElementById("confetti-canvas");
        const sec = document.getElementById("countdown");
        if (!canvas || !sec) return;

        const ctx = canvas.getContext("2d");
        let w = (canvas.width = sec.offsetWidth);
        let h = (canvas.height = sec.offsetHeight);

        const palette = ["#c89d2a", "#e4c56c", "#9e1b1b", "#c94a4a", "#ebd7a7"];
        const pieces = Array.from({ length: 48 }, () => ({
          x: Math.random() * w,
          y: Math.random() * h,
          r: 3 + Math.random() * 5,
          vy: 0.35 + Math.random() * 0.65,
          vx: (Math.random() - 0.5) * 0.45,
          rot: Math.random() * Math.PI * 2,
          vrot: (Math.random() - 0.5) * 0.03,
          color: palette[Math.floor(Math.random() * palette.length)],
          shape: Math.floor(Math.random() * 3)
        }));

        window.addEventListener("resize", () => {
          w = canvas.width = sec.offsetWidth;
          h = canvas.height = sec.offsetHeight;
        });

        function render() {
          ctx.clearRect(0, 0, w, h);
          pieces.forEach((p) => {
            p.y += p.vy;
            p.x += p.vx + Math.sin(p.rot) * 0.25;
            p.rot += p.vrot;

            if (p.y > h + 15) {
              p.y = -15;
              p.x = Math.random() * w;
            }

            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate(p.rot);
            ctx.fillStyle = p.color;
            ctx.globalAlpha = 0.78;

            if (p.shape === 0) {
              ctx.beginPath();
              ctx.arc(0, 0, p.r * 0.55, 0, Math.PI * 2);
              ctx.fill();
            } else if (p.shape === 1) {
              ctx.fillRect(-p.r * 0.7, -p.r * 0.35, p.r * 1.4, p.r * 0.7);
            } else {
              ctx.beginPath();
              ctx.moveTo(0, -p.r);
              ctx.quadraticCurveTo(p.r * 0.85, 0, 0, p.r);
              ctx.quadraticCurveTo(-p.r * 0.85, 0, 0, -p.r);
              ctx.fill();
            }
            ctx.restore();
          });
          requestAnimationFrame(render);
        }
        render();
      }

      // 5. Floating Music Player (MP3 + Web Audio Chime Fallback)
      function initMusicPlayer() {
        const btn = document.getElementById("music-toggle-btn");
        const playIcon = document.getElementById("icon-play");
        const pauseIcon = document.getElementById("icon-pause");
        const label = document.getElementById("music-pill-text");
        const audioEl = document.getElementById("wedding-audio");

        let playing = false;
        let ctx = null;
        let timer = null;
        let idx = 0;

        const notes = [349.23, 440.0, 523.25, 659.25, 523.25, 440.0, 293.66, 349.23, 440.0, 523.25];

        function chime(freq) {
          if (!ctx) return;
          const now = ctx.currentTime;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = "sine";
          osc.frequency.setValueAtTime(freq, now);
          gain.gain.setValueAtTime(0.0001, now);
          gain.gain.exponentialRampToValueAtTime(0.06, now + 0.08);
          gain.gain.exponentialRampToValueAtTime(0.0001, now + 2.2);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now);
          osc.stop(now + 2.3);
        }

        function setUI(state) {
          playing = state;
          playIcon.style.display = state ? "none" : "block";
          pauseIcon.style.display = state ? "block" : "none";
          label.innerHTML = state ? "&#9834; PAUSE MUSIC" : "&#9834; PLAY MUSIC";
        }

        btn.addEventListener("click", async () => {
          if (!playing) {
            if (WEDDING_CONFIG.customAudioSrc) {
              try {
                if (!audioEl.src) audioEl.src = WEDDING_CONFIG.customAudioSrc;
                await audioEl.play();
                setUI(true);
                return;
              } catch (e) {
                // Fallback to built-in chime melody
              }
            }
            const AudioCtx = window.AudioContext || window.webkitAudioContext;
            if (!ctx) ctx = new AudioCtx();
            if (ctx.state === "suspended") await ctx.resume();
            chime(notes[idx++ % notes.length]);
            timer = setInterval(() => chime(notes[idx++ % notes.length]), 720);
            setUI(true);
          } else {
            if (!audioEl.paused) audioEl.pause();
            if (timer) {
              clearInterval(timer);
              timer = null;
            }
            setUI(false);
          }
        });
      }

      // 6. Transport Modal
      function initModal() {
        const modal = document.getElementById("transport-modal");
        const openBtn = document.getElementById("open-transport-btn");
        const closeBtn = document.getElementById("close-transport-btn");

        openBtn.addEventListener("click", () => modal.classList.add("is-open"));
        closeBtn.addEventListener("click", () => modal.classList.remove("is-open"));
        modal.addEventListener("click", (e) => {
          if (e.target === modal) modal.classList.remove("is-open");
        });
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") modal.classList.remove("is-open");
        });
      }

      window.addEventListener("DOMContentLoaded", () => {
        hydrateContent();
        initHeroFirecrackers();
        initCountdown();
        initCountdownConfetti();
        initMusicPlayer();
        initModal();
      });
    })();
