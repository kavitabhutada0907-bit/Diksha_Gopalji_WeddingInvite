       3. SECTION 2: FAMILY INVITATION NOTE (DEEP BURGUNDY)
       ===================================================================== */
    .invitation-section {
      background-color: var(--burgundy-deep);
      color: #ffffff;
      padding: 6rem 1.5rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
