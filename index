       ===================================================================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 200;
      background-color: rgba(18, 8, 9, 0.68);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
    }

    .modal-backdrop.is-open {
      display: flex;
    }

    .modal-dialog {
      position: relative;
      width: 100%;
      max-width: 500px;
      background-color: var(--cream-bg);
      color: var(--text-dark);
      border-radius: 6px;
      padding: 2rem;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(104, 19, 29, 0.15);
    }

    .modal-close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background-color: rgba(104, 19, 29, 0.1);
      color: var(--burgundy-deep);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .modal-eyebrow {
      font-family: var(--font-caps);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--burgundy-deep);
      margin-bottom: 0.25rem;
    }

    .modal-title {
      font-family: var(--font-script);
      font-size: 2.6rem;
      color: var(--burgundy-deep);
      margin-bottom: 1.25rem;
    }

    .transport-item {
      background-color: #ffffff;
      border: 1px solid rgba(104, 19, 29, 0.12);
      border-radius: 4px;
      padding: 1rem 1.15rem;
      margin-bottom: 0.85rem;
    }

    .transport-mode-tag {
      font-family: var(--font-caps);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--burgundy-deep);
      margin-bottom: 0.2rem;
    }

    .transport-item h4 {
      font-family: var(--font-serif);
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 0.25rem;
    }

    .transport-item p {
      font-family: var(--font-serif);
      font-size: 0.98rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* =====================================================================
       10. RESPONSIVE MEDIA QUERIES
       ===================================================================== */
    @media (max-width: 600px) {
      .hero-section {
        padding: 2.25rem 1rem 5.5rem;
      }

      .hero-date-badge {
        font-size: 0.68rem;
        letter-spacing: 0.2em;
        padding: 0.45rem 1.15rem;
      }

      .hero-footer-grid {
        gap: 0.5rem;
      }

      .parent-label {
        font-size: 0.58rem;
        letter-spacing: 0.14em;
      }

      .parent-names {
        font-size: 0.92rem;
      }

      .scroll-circle-btn {
        width: 38px;
        height: 38px;
      }

      .timeline-row {
        grid-template-columns: 1fr 28px 1fr;
        gap: 0.45rem;
      }

      .music-pill {
        bottom: 16px;
        right: 16px;
        padding: 0.42rem 1rem 0.42rem 0.45rem;
      }
    }
  </style>
