    .venue-card {
      width: 100%;
      max-width: 440px;
      text-align: left;
    }

    .venue-title {
      font-family: var(--font-serif);
      font-weight: 700;
      font-size: clamp(1.65rem, 3.5vw, 2.1rem);
      color: var(--text-dark);
      margin-bottom: 1.15rem;
      line-height: 1.25;
    }

    .venue-address-list {
      font-family: var(--font-serif);
      font-size: 1.1rem;
      color: var(--text-muted);
      line-height: 1.75;
      margin-bottom: 2rem;
