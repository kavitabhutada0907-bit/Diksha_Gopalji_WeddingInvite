    .music-pill {
      position: fixed;
      bottom: 22px;
      right: 22px;
      z-index: 100;
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      background-color: var(--pill-bg);
      color: #ffffff;
      padding: 0.5rem 1.25rem 0.5rem 0.55rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.38);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .music-pill:hover {
      transform: scale(1.03);
      box-shadow: 0 14px 32px rgba(0, 0, 0, 0.48);
    }

    .music-pill-icon {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background-color: var(--pill-accent);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .music-pill-label {
      font-family: var(--font-caps);
      font-size: 0.68rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #ffffff;
    }

