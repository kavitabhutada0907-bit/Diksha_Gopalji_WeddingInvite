      font-style: italic;
      font-size: clamp(1.15rem, 2.4vw, 1.38rem);
      line-height: 1.85;
      color: rgba(255, 255, 255, 0.94);
      margin-bottom: 2.25rem;
    }

    .invitation-scroll-wrap {
      margin-bottom: 1.75rem;
