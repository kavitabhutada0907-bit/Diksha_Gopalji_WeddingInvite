      --pill-bg: #261918;
      --pill-accent: #9e1b1b;

      --font-hero-display: 'Cinzel Decorative', Georgia, serif;
      --font-caps: 'Montserrat', sans-serif;
      --font-serif: 'Cormorant Garamond', Georgia, serif;
